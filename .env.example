# Swing Guru analysis service - copy to .env for local Docker runs; set the same keys in Railway.
# Never commit real values.

SG_ENV=production                 # development | production
SG_PUBLIC_URL=https://your-service.up.railway.app

SG_AUTH_MODE=supabase             # supabase | dev (dev is refused in production)
SG_STORAGE=supabase               # supabase | local
SG_DB=supabase                    # supabase | sqlite
SG_BUCKET=swings

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # server only - never put this in the mobile app
SUPABASE_JWT_SECRET=              # only for legacy HS256 projects; leave empty to use the project's JWKS

SG_MAX_UPLOAD_MB=500
SG_JOBS_PER_HOUR=20
SG_MAX_ACTIVE_JOBS=2
SG_ANALYSIS_TIMEOUT_S=600
SG_SOURCE_RETENTION_HOURS=0       # 0 = delete the original upload as soon as its analysis ends
SG_WORKER_ENABLED=true
LOG_LEVEL=INFO

# Billing (RevenueCat) - OFF by default; with SG_BILLING_MODE=off the service
# behaves exactly as before. Turning it on requires every value below, otherwise
# the service refuses to start (a half-configured billing deployment is never
# free paid access).
SG_BILLING_MODE=off               # off | on
SG_BILLING_ENV=                   # production | sandbox (sandbox = TestFlight/sandbox testing only)
SG_BILLING_PAID_ALLOWANCE=        # must be explicitly "unlimited" while billing is on
SG_BILLING_FREE_ANALYSES=3        # free analyses per Supabase account, then the paywall
SG_BILLING_ALLOWED_STORES=app_store
REVENUECAT_SECRET_KEY=            # server only (sk_...) - never put this in the mobile app
REVENUECAT_ENTITLEMENT_ID=pro
REVENUECAT_MONTHLY_PRODUCT_ID=com.swingguru.app.pro.monthly
REVENUECAT_YEARLY_PRODUCT_ID=com.swingguru.app.pro.yearly
REVENUECAT_LIFETIME_PRODUCT_ID=com.swingguru.app.pro.lifetime

# Sign in with Apple - account deletion and server-side revocation.
# These are SERVER-ONLY secrets. Never put them in the mobile app, docs, logs or chat. Set all four
# values or none: none keeps guest use working exactly as before, while a partial set is refused at
# startup. With none set, deleting an account that has an Apple identity is refused (503
# apple_unavailable) rather than pretending it revoked anything.
SG_APPLE_TEAM_ID=                 # 10-character Apple Developer team id
SG_APPLE_KEY_ID=                  # Key ID of the Sign in with Apple private key (.p8)
SG_APPLE_PRIVATE_KEY_PATH=        # path to the .p8 file (preferred)
SG_APPLE_PRIVATE_KEY=             # ...or the PEM contents inline (local development only)
SG_APPLE_TOKEN_KEY=               # base64 of 32 random bytes; encrypts the refresh token at rest
SG_APPLE_CLIENT_ID=com.swingguru.app   # the bundle identifier; fixed, not a Services ID
SG_APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
