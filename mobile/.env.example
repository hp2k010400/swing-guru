# Public build-time values (embedded in the app - no secrets). Set them per environment in EAS
# (eas env:create) or in mobile/.env for local development.
EXPO_PUBLIC_API_URL=https://your-service.up.railway.app
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
EXPO_PUBLIC_AUTH_MODE=supabase
EXPO_PUBLIC_PRIVACY_URL=https://swingguru.app/privacy
EXPO_PUBLIC_SUPPORT_URL=https://swingguru.app/support

# RevenueCat *public* iOS SDK key (appl_...). Public by design - never a secret key (sk_...).
# Leave empty to ship a build with no paywall: analysis keeps working in that build. This is a
# client-side switch only - it does not change the server's billing gate.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# The RevenueCat entitlement that unlocks analysis. Must match the server's REVENUECAT_ENTITLEMENT_ID.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
# The three accepted products. The paywall only offers these ids with the matching period, so a
# misconfigured package can never be sold and then refused by the server. Keep them identical to
# the server's REVENUECAT_*_PRODUCT_ID values.
EXPO_PUBLIC_REVENUECAT_MONTHLY_PRODUCT_ID=com.swingguru.app.pro.monthly
EXPO_PUBLIC_REVENUECAT_YEARLY_PRODUCT_ID=com.swingguru.app.pro.yearly
EXPO_PUBLIC_REVENUECAT_LIFETIME_PRODUCT_ID=com.swingguru.app.pro.lifetime
# Terms of use shown on the paywall. Defaults to Apple's standard EULA when unset.
EXPO_PUBLIC_TERMS_URL=https://www.apple.com/legal/internet-services/itunes/dev/stdeula/

# Local development against `python -m swingguru.service` on your PC (same Wi-Fi):
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8790
# EXPO_PUBLIC_AUTH_MODE=dev
